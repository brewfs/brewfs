+                .ok_or(WorkspaceError::WorkspaceNotFound(request.workspace_id))?;
+            if workspace.state != WorkspaceState::Active {
+                return Err(WorkspaceError::InvalidStateTransition {
+                    from: format!("{:?}", workspace.state),
+                    to: "Sealing".into(),
