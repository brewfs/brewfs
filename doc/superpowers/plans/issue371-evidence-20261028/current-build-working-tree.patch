+    // The native mount also holds the exclusive workspace lease and is the
+    // only upper writer. Bind its row caches to that lease so repeated
+    // writeback permission/inode reads do not round-trip through Redis. The
+    // cache is cleared and bypassed as soon as the lease proof is lost, and
+    // local mutations invalidate the rows they write.
+    let row_cache_ttl = std::env::var("BREWFS_WORKSPACE_ROW_CACHE_TTL_MS")
+        .ok()
+        .and_then(|value| value.parse::<u64>().ok())
+        .map(Duration::from_millis)
+        .unwrap_or(LEASE_BOUND_ROW_CACHE_TTL);
+    let lease_validity = session.lease_validity();
+    meta_layer = meta_layer
+        .with_upper_row_cache(row_cache_ttl)
+        .with_lease_bound_row_cache(lease_validity);
     let meta_layer = Arc::new(meta_layer);
     meta_layer.initialize().await?;
     let overlay = Arc::new(WriteOverlay::new(control.clone(), sink, params));
