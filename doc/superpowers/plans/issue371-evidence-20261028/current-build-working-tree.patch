+#[tokio::test]
+async fn native_lease_bound_row_cache_reuses_rows_and_invalidates_mutations() {
+    use super::row_cache::RowKey;
+    use crate::workspace_overlay::lifecycle::LeaseValidity;
+    use std::time::{Duration, Instant};
+
+    // test_meta uses the native workspace lower (there is no packed binding),
+    // matching workspace-native-v2's metadata shape.
+    let meta = test_meta()
+        .await
+        .with_upper_row_cache(Duration::from_secs(60))
+        .with_lease_bound_row_cache(Arc::new(LeaseValidity::new(
+            Instant::now(),
+            Duration::from_secs(60),
+        )));
+    let ino = meta
+        .create_file(meta.root_ino(), "native-cache".into())
+        .await
+        .unwrap();
+    let cache = meta
+        .upper_row_cache()
+        .expect("native row cache is installed");
+    let hits_before = meta
+        .row_cache_counters
+        .hits
+        .load(std::sync::atomic::Ordering::Relaxed);
+    meta.stat(ino).await.unwrap().expect("created inode");
+    meta.stat(ino).await.unwrap().expect("created inode");
+    assert!(
+        meta.row_cache_counters
+            .hits
+            .load(std::sync::atomic::Ordering::Relaxed)
+            > hits_before,
+        "repeated native stat should hit the lease-bound inode-row cache"
+    );
+    assert!(cache.get(&RowKey::Inode(ino)).is_some());
+
+    meta.set_attr(
+        ino,
+        &SetAttrRequest {
+            mode: Some(0o100600),
+            ..SetAttrRequest::default()
+        },
+        SetAttrFlags::empty(),
+    )
+    .await
+    .unwrap();
+    assert!(
+        cache.get(&RowKey::Inode(ino)).is_none(),
+        "a local mutation must invalidate the changed native inode row"
+    );
+    assert_eq!(meta.stat(ino).await.unwrap().unwrap().mode, 0o100600);
+}
