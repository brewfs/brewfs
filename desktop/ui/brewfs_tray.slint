// BrewFS desktop tray UI (Slint 1.17).
// The SystemTrayIcon component is native in Slint 1.17: on Windows it uses
// Shell_NotifyIcon, on Linux/BSD ksni, on macOS NSStatusItem.

import { Button, CheckBox, ComboBox, GridBox, GroupBox, LineEdit, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct MountInfo {
    drive: string,
    backend: string,
    detail: string,
    pid: int,
    alive: bool,
}

/// A saved configuration record shown in the main list, with its current
/// mount state.
export struct ProfileRecord {
    name: string,
    drive: string,
    detail: string,
    mounted: bool,
}

component DriveBadge inherits Rectangle {
    in property <string> drive;
    in property <bool> mounted;
    width: 48px;
    height: 30px;
    background: root.mounted ? #1b7a3d : #cfd3da;
    border-radius: 7px;
    Text {
        text: root.drive;
        color: white;
        font-weight: 700;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component MainWindow inherits Window {
    title: "BrewFS";
    icon: @image-url("../assets/brewfs.png");
    preferred-width: 720px;
    preferred-height: 560px;

    in property <string> status-text;
    in property <[ProfileRecord]> records;
    in-out property <bool> autostart;

    // 确认覆盖层
    in property <bool> dlg-visible;
    in property <string> dlg-message;
    // 编辑覆盖层（独立编辑窗口的效果，无第二个任务栏图标）
    in property <bool> edit-visible;
    in property <string> edit-title;

    // 表单（编辑覆盖层内）
    in-out property <string> cfg-name;
    in-out property <int> cfg-mode-index;
    in-out property <int> cfg-drive-index;
    in-out property <string> cfg-drive;
    in-out property <bool> show-free-drives;
    in property <[string]> drive-options;
    in-out property <int> cfg-backend-index;
    in-out property <string> cfg-data-dir;
    in-out property <string> cfg-s3-bucket;
    in-out property <string> cfg-s3-endpoint;
    in-out property <string> cfg-s3-region;
    in-out property <string> cfg-s3-access-key;
    in-out property <string> cfg-s3-secret-key;
    in-out property <bool> cfg-s3-force-path-style;
    in-out property <string> cfg-prefix;
    in-out property <int> cfg-meta-index;
    in-out property <string> cfg-meta-url;

    property <string> cfg-mode: cfg-mode-index == 0 ? "oss" : "brewfs";
    property <string> cfg-backend: cfg-backend-index == 1 ? "s3" : "local-fs";
    property <string> cfg-meta-backend: cfg-meta-index == 1 ? "redis" : (cfg-meta-index == 2 ? "etcd" : (cfg-meta-index == 3 ? "tikv" : "sqlx"));

    callback save-form();
    callback cancel-edit();
    callback add-config();
    callback edit-record(int);
    callback open-record(int);
    callback toggle-record(int);
    callback delete-record(int);
    callback confirm-dialog();
    callback cancel-dialog();
    callback autostart-changed(bool);
    callback quit-app();

    Rectangle {
        background: #f4f6f9;

        VerticalBox {
            padding: 16px;
            spacing: 12px;

            // --- 顶部标题 ---
            HorizontalBox {
                spacing: 12px;
                Rectangle {
                    width: 38px;
                    height: 38px;
                    border-radius: 9px;
                    background: #1a6dd4;
                    Text {
                        text: "☁";
                        color: white;
                        font-size: 22px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                VerticalBox {
                    spacing: 2px;
                    Text { text: "BrewFS"; font-size: 19px; font-weight: 700; color: #15181c; }
                    Text { text: "OSS / S3 挂载到本地磁盘"; font-size: 12px; color: #8a919c; }
                }
            }

            // --- 配置列表（主界面只有列表） ---
            GroupBox {
                title: "我的配置";
                vertical-stretch: 1.0;
                VerticalBox {
                    spacing: 8px;
                    ScrollView {
                        vertical-stretch: 1.0;
                        min-height: 260px;
                        VerticalBox {
                            spacing: 6px;
                            for r[i] in root.records: Rectangle {
                                background: r.mounted ? #eaf4ee : #ffffff;
                                border-radius: 9px;
                                border-width: 1px;
                                border-color: r.mounted ? #b7d9c4 : #e3e7ed;
                                TouchArea {
                                    clicked => { root.edit-record(i); }
                                    HorizontalBox {
                                        padding: 8px;
                                        spacing: 10px;
                                        DriveBadge { drive: r.drive; mounted: r.mounted; }
                                        VerticalBox {
                                            min-width: 0px;
                                            horizontal-stretch: 1.0;
                                            spacing: 2px;
                                            Text {
                                                text: r.name;
                                                color: #15181c;
                                                font-weight: 600;
                                                font-size: 13px;
                                                overflow: elide;
                                            }
                                            Text {
                                                min-width: 0px;
                                                text: r.detail;
                                                color: #7a828d;
                                                font-size: 12px;
                                                overflow: elide;
                                            }
                                        }
                                        Text {
                                            text: r.mounted ? "●" : "○";
                                            color: r.mounted ? #1b7a3d : #c3c9d1;
                                            font-size: 14px;
                                        }
                                    }
                                }
                                HorizontalBox {
                                    y: 0px;
                                    height: parent.height;
                                    x: parent.width - 190px;
                                    width: 190px;
                                    alignment: end;
                                    padding-right: 8px;
                                    Button {
                                        text: "📂";
                                        Tooltip { text: @markdown("打开"); }
                                        enabled: r.mounted;
                                        height: 26px;
                                        clicked => { root.open-record(i); }
                                    }
                                    Button {
                                        text: r.mounted ? "⏏" : "🔗";
                                        Tooltip {
                                            Rectangle {
                                                background: #3b4048;
                                                border-radius: 4px;
                                                VerticalLayout {
                                                    padding-left: 10px; padding-right: 10px; padding-top: 6px; padding-bottom: 6px;
                                                    Text { text: r.mounted ? "卸载" : "挂载"; color: #ffffff; font-size: 12px; }
                                                }
                                            }
                                        }
                                        height: 26px;
                                        clicked => { root.toggle-record(i); }
                                    }
                                    Button {
                                        text: "✏️";
                                        Tooltip { text: @markdown("编辑"); }
                                        height: 26px;
                                        clicked => { root.edit-record(i); }
                                    }
                                    Button {
                                        text: "🗑";
                                        Tooltip { text: @markdown("删除"); }
                                        height: 26px;
                                        clicked => { root.delete-record(i); }
                                    }
                                }
                            }
                            if root.records.length == 0: Text { text: "（还没有配置，点下方「添加配置」）"; color: #9aa1ab; }
                        }
                    }
                    Text { text: "📂打开  🔗挂载/⏏卸载  ✏️编辑  🗑删除（点击整行也可编辑）"; color: #9aa1ab; font-size: 12px; }
                }
            }

            // --- 底部 ---
            HorizontalBox {
                spacing: 10px;
                alignment: end;
                CheckBox {
                    text: "开机自启";
                    checked: root.autostart;
                    toggled => {
                        root.autostart = self.checked;
                        root.autostart-changed(self.checked);
                    }
                }
                Rectangle { horizontal-stretch: 1.0; }
                Button {
                    text: "➕ 添加配置";
                    primary: true;
                    clicked => { root.add-config(); }
                }
            }

            // --- 反馈 ---
            Text {
                text: root.status-text;
                color: #8a919c;
                font-size: 12px;
                wrap: word-wrap;
            }
        }

        // --- 编辑覆盖层（独立编辑窗口） ---
        if root.edit-visible: Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: #66000000;
            TouchArea {
                clicked => { /* 吞掉遮罩点击 */ }
            }
            HorizontalBox {
                alignment: center;
                VerticalBox {
                    alignment: center;
                    Rectangle {
                        min-width: 560px;
                        max-width: 660px;
                        background: #ffffff;
                        border-radius: 12px;
                        VerticalBox {
                            padding: 20px;
                            spacing: 14px;
                            Text {
                                text: root.edit-title;
                                font-size: 16px;
                                font-weight: 700;
                                color: #15181c;
                            }
                            ScrollView {
                                max-height: 430px;
                                GridBox {
                                    spacing: 10px;
                                    Row {
                                        Text { text: "配置名称"; vertical-alignment: center; }
                                        LineEdit {
                                            text: root.cfg-name;
                                            placeholder-text: "例如：阿里云 OSS";
                                        }
                                    }
                                    Row {
                                        Text { text: "挂载点"; vertical-alignment: center; }
                                        if root.show-free-drives: ComboBox {
                                            model: root.drive-options;
                                            current-index: root.cfg-drive-index;
                                            selected(v) => {
                                                root.cfg-drive = v;
                                            }
                                        }
                                        if !root.show-free-drives: LineEdit {
                                            text: root.cfg-drive;
                                            placeholder-text: "macOS/Linux 挂载目录，例如 /Volumes/brewfs";
                                            input-type: text;
                                        }
                                    }
                                    Row {
                                        Text { text: "挂载模式"; vertical-alignment: center; }
                                        ComboBox {
                                            model: ["OSS 直挂（多机，推荐）", "BrewFS（元数据）"];
                                            current-index: root.cfg-mode-index;
                                            selected(v) => {
                                                root.cfg-mode-index = v == "BrewFS（元数据）" ? 1 : 0;
                                            }
                                        }
                                    }
                                    if root.cfg-mode == "brewfs": Rectangle {
                                        background: #fff4e0;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: #e0a030;
                                        HorizontalBox {
                                            padding: 8px;
                                            Text {
                                                text: "⚠️ 元数据模式需要自建/共享元数据库（Redis/TiKV/etcd）；多机必须连同一个元数据库否则数据不一致；数据库故障则盘不可用。普通网盘推荐 OSS 直挂。";
                                                color: #7a4d00;
                                                wrap: word-wrap;
                                                font-size: 12px;
                                            }
                                        }
                                    }
                                    if root.cfg-mode == "brewfs": Row {
                                        Text { text: "数据后端"; vertical-alignment: center; }
                                        ComboBox {
                                            model: ["local-fs", "s3"];
                                            current-index: root.cfg-backend-index;
                                            selected(v) => {
                                                root.cfg-backend-index = v == "s3" ? 1 : 0;
                                            }
                                        }
                                    }
                                    if root.cfg-mode == "brewfs": Row {
                                        Text { text: "元数据后端"; vertical-alignment: center; }
                                        ComboBox {
                                            model: ["sqlx", "redis", "etcd", "tikv"];
                                            current-index: root.cfg-meta-index;
                                            selected(v) => {
                                                root.cfg-meta-index = v == "redis" ? 1 : (v == "etcd" ? 2 : (v == "tikv" ? 3 : 0));
                                            }
                                        }
                                    }
                                    if root.cfg-mode == "brewfs" && root.cfg-backend == "local-fs": Row {
                                        Text { text: "数据目录"; vertical-alignment: center; }
                                        LineEdit {
                                            text: root.cfg-data-dir;
                                            placeholder-text: "本地对象存储目录，例如 E:\\brewfs-data";
                                        }
                                    }
                                    if root.cfg-mode == "oss" || (root.cfg-mode == "brewfs" && root.cfg-backend == "s3"): Row {
                                        Text { text: "Bucket"; vertical-alignment: center; }
                                        LineEdit { text: root.cfg-s3-bucket; placeholder-text: "OSS bucket 名称"; }
                                        Text { text: "Region"; vertical-alignment: center; }
                                        LineEdit { text: root.cfg-s3-region; placeholder-text: "例如 cn-shanghai"; }
                                    }
                                    if root.cfg-mode == "oss" || (root.cfg-mode == "brewfs" && root.cfg-backend == "s3"): Row {
                                        Text { text: "Endpoint"; vertical-alignment: center; }
                                        LineEdit {
                                            text: root.cfg-s3-endpoint;
                                            placeholder-text: "S3 兼容接入点，例如 https://s3.oss-cn-shanghai.aliyuncs.com";
                                        }
                                    }
                                    if root.cfg-mode == "oss" || (root.cfg-mode == "brewfs" && root.cfg-backend == "s3"): Row {
                                        Text { text: "AccessKey"; vertical-alignment: center; }
                                        LineEdit {
                                            text: root.cfg-s3-access-key;
                                            placeholder-text: "AK";
                                        }
                                        Text { text: "SecretKey"; vertical-alignment: center; }
                                        LineEdit {
                                            text: root.cfg-s3-secret-key;
                                            placeholder-text: "SK（本地保存，不写入提交）";
                                            input-type: password;
                                        }
                                    }
                                    if root.cfg-mode == "oss" || (root.cfg-mode == "brewfs" && root.cfg-backend == "s3"): Row {
                                        CheckBox {
                                            text: "force_path_style（MinIO/自建 S3 需要）";
                                            checked: root.cfg-s3-force-path-style;
                                        }
                                    }
                                    if root.cfg-mode == "oss": Row {
                                        Text { text: "Prefix"; vertical-alignment: center; }
                                        LineEdit {
                                            text: root.cfg-prefix;
                                            placeholder-text: "对象 key 命名空间（可选），例如 myns/；多机共享时保持一致";
                                        }
                                    }
                                    if root.cfg-mode == "brewfs": Row {
                                        Text { text: "元数据 URL"; vertical-alignment: center; }
                                        LineEdit {
                                            text: root.cfg-meta-url;
                                            placeholder-text: "sqlite://./data/brewfs-meta.db?mode=rwc 或 redis://... 或 etcd/tikv 地址（逗号分隔）";
                                        }
                                    }
                                }
                            }
                            HorizontalBox {
                                alignment: end;
                                spacing: 10px;
                                Button {
                                    text: "取消";
                                    clicked => { root.cancel-edit(); }
                                }
                                Button {
                                    text: "保存";
                                    primary: true;
                                    clicked => { root.save-form(); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // --- 确认覆盖层（真模态） ---
        if root.dlg-visible: Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: #66000000;
            TouchArea {
                clicked => { }
            }
            HorizontalBox {
                alignment: center;
                VerticalBox {
                    alignment: center;
                    Rectangle {
                        min-width: 340px;
                        max-width: 480px;
                        background: #ffffff;
                        border-radius: 10px;
                        HorizontalBox {
                            padding: 20px;
                            spacing: 16px;
                            VerticalBox {
                                spacing: 18px;
                                Text {
                                    text: root.dlg-message;
                                    wrap: word-wrap;
                                    font-size: 14px;
                                    color: #15181c;
                                }
                                HorizontalBox {
                                    alignment: end;
                                    spacing: 10px;
                                    Button {
                                        text: "取消";
                                        clicked => { root.cancel-dialog(); }
                                    }
                                    Button {
                                        text: "确定";
                                        primary: true;
                                        clicked => { root.confirm-dialog(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component Tray inherits SystemTrayIcon {
    icon: @image-url("../assets/brewfs.png");
    tooltip: root.tray-tooltip;
    in property <string> tray-tooltip;
    in property <[MountInfo]> mounts;

    callback show-window();
    callback open-mount(int);
    callback unmount-all();
    callback quit-app();

    clicked => {
        root.show-window();
    }

    Menu {
        MenuItem {
            title: "显示窗口";
            activated => { root.show-window(); }
        }
        Menu {
            title: "已挂载盘符";
            for m[i] in root.mounts: MenuItem {
                title: m.drive + "  " + m.backend;
                activated => { root.open-mount(i); }
            }
            if root.mounts.length == 0: MenuItem {
                title: "（无挂载）";
                enabled: false;
            }
        }
        MenuItem {
            title: "卸载全部";
            activated => { root.unmount-all(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "退出 BrewFS";
            activated => { root.quit-app(); }
        }
    }
}
