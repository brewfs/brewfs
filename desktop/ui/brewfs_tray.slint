// BrewFS desktop tray UI (Slint 1.17).

import {
    Button,
    CheckBox,
    ComboBox,
    GridBox,
    GroupBox,
    LineEdit,
    ScrollView,
    VerticalBox,
    HorizontalBox,
} from "std-widgets.slint";

export struct MountInfo {
    drive: string,
    backend: string,
    detail: string,
    pid: int,
    alive: bool,
}

/// A saved configuration record shown in the main list, with its current
/// mount state.
export struct ProfileRecord {
    name: string,
    drive: string,
    detail: string,
    mounted: bool,
    /// 挂载进行中（进程已启动、尚未真正挂上）：挂载按钮禁用，防止重复点击。
    mounting: bool,
}

component DriveBadge inherits Rectangle {
    in property <string> drive;
    in property <bool> mounted;
    width: 40px;
    height: 26px;
    background: root.mounted ? @linear-gradient(135deg, #1b7a3d 0%, #2ea35a 100%) : #cdd3dc;
    border-radius: 7px;
    Text {
        text: root.drive;
        color: white;
        font-weight: 700;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    in property <string> tip;
    callback clicked;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: root.enabled ? #ffffff : #f2f4f8;
    border-width: 1px;
    border-color: root.enabled ? #dde3ec : #e8ecf2;
    Image {
        source: root.icon;
        width: 18px;
        height: 18px;
        x: (parent.width - 18px) / 2;
        y: (parent.height - 18px) / 2;
        opacity: root.enabled ? 1.0 : 0.4;
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    if root.tip != "": Tooltip {
        Rectangle {
            background: #3b4048;
            border-radius: 4px;
            VerticalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 5px;
                padding-bottom: 5px;
                Text {
                    text: root.tip;
                    color: #ffffff;
                    font-size: 12px;
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "BrewFS";
    icon: @image-url("../assets/brewfs.png");
    preferred-width: 320px;
    preferred-height: 540px;
    min-width: 320px;
    max-width: 320px;
    min-height: 540px;
    max-height: 540px;

    in property <string> status-text;
    in property <[ProfileRecord]> records;
    // macOS: content extends under the hidden titlebar; keep room for the
    // native traffic-light buttons in the top-left corner.
    in property <bool> traffic-light-padding;

    // 确认覆盖层
    in property <bool> dlg-visible;
    in property <string> dlg-message;
    callback add-config();
    callback edit-record(int);
    callback open-record(int);
    callback toggle-record(int);
    callback delete-record(int);
    callback confirm-dialog();
    callback cancel-dialog();
    callback quit-app();

    Rectangle {
        background: #eef1f6;
        width: 100%;
        height: 100%;

        VerticalBox {
            padding: 2px;
            spacing: 0px;

            // macOS: blank row so the traffic-light buttons don't overlap content.
            if root.traffic-light-padding: Rectangle {
                height: 28px;
            }

            // ===== 顶部标题栏 =====
            Rectangle {
                background: #ffffff;
                HorizontalBox {
                    cross-axis-alignment: center;
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 8px;
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 8px;
                        background: @linear-gradient(135deg, #1a6dd4 0%, #0e4ea8 100%);
                        Image {
                            source: @image-url("../assets/icons/cloud.svg");
                            width: 20px;
                            height: 20px;
                            x: (parent.width - 20px) / 2;
                            y: (parent.height - 20px) / 2;
                        }
                    }

                    VerticalBox {
                        min-width: 0px;
                        horizontal-stretch: 1.0;
                        spacing: 1px;
                        Text {
                            text: "BrewFS";
                            font-size: 15px;
                            font-weight: 700;
                            color: #151a21;
                        }

                        Text {
                            text: "OSS / S3 挂载";
                            font-size: 11px;
                            color: #7c8591;
                            overflow: elide;
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: #e2e7ef;
            }

            // ===== 配置列表 =====
            VerticalBox {
                padding-left: 0px;
                padding-right: 0px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 4px;
                vertical-stretch: 1.0;
                horizontal-stretch: 1.0;
                HorizontalLayout {
                    padding-left: 2px;
                    padding-right: 2px;
                    Text {
                        text: "我的配置";
                        font-size: 12px;
                        font-weight: 600;
                        color: #5a6472;
                        horizontal-stretch: 1.0;
                    }
                }

                if root.records.length > 0: ScrollView {
                    vertical-stretch: 1.0;
                    horizontal-stretch: 1.0;
                    min-height: 0px;
                    VerticalBox {
                        padding-left: 2px;
                        padding-right: 2px;
                        padding-top: 0px;
                        padding-bottom: 0px;
                        spacing: 8px;
                        for r[i] in root.records: Rectangle {
                            background: r.mounted ? #f0f7f3 : (r.mounting ? #eef4ff : #ffffff);
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: r.mounted ? #bfe0cc : (r.mounting ? #b8d0f0 : #e2e7ef);
                            height: 48px;
                            HorizontalLayout {
                                padding: 2px;
                                spacing: 4px;
                                cross-axis-alignment: center;
                                TouchArea {
                                    horizontal-stretch: 1.0;
                                    clicked => { root.edit-record(i); }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        cross-axis-alignment: center;
                                        DriveBadge {
                                            drive: r.drive;
                                            mounted: r.mounted;
                                        }

                                        VerticalLayout {
                                            spacing: 2px;
                                            Text {
                                                text: r.name;
                                                color: #1b2129;
                                                font-weight: 600;
                                                font-size: 13px;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: r.detail;
                                                color: #7c8591;
                                                font-size: 11px;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }

                                IconButton {
                                    icon: @image-url("../assets/icons/open.svg");
                                    enabled: r.mounted;
                                    tip: "打开";
                                    clicked => { root.open-record(i); }
                                }

                                if r.mounted: IconButton {
                                    icon: @image-url("../assets/icons/unmount.svg");
                                    tip: "卸载";
                                    clicked => { root.toggle-record(i); }
                                }
                                if !r.mounted: IconButton {
                                    icon: @image-url("../assets/icons/mount.svg");
                                    enabled: !r.mounting;
                                    tip: r.mounting ? "挂载中…" : "挂载";
                                    clicked => { root.toggle-record(i); }
                                }
                                IconButton {
                                    icon: @image-url("../assets/icons/edit.svg");
                                    tip: "编辑";
                                    clicked => { root.edit-record(i); }
                                }

                                IconButton {
                                    icon: @image-url("../assets/icons/delete.svg");
                                    tip: "删除";
                                    clicked => { root.delete-record(i); }
                                }
                            }
                        }
                    }
                }
                if root.records.length == 0: HorizontalLayout {
                    vertical-stretch: 1.0;
                    horizontal-stretch: 1.0;
                    padding-left: 2px;
                    padding-right: 2px;
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        background: #ffffff;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #e2e7ef;
                        VerticalBox {
                            alignment: center;
                            spacing: 6px;
                            HorizontalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../assets/icons/empty.svg");
                                    width: 40px;
                                    height: 40px;
                                }
                            }

                            HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: "还没有配置";
                                    color: #8a939e;
                                    font-size: 13px;
                                    font-weight: 600;
                                }
                            }

                            HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: "点下方「添加配置」";
                                    color: #aeb6c1;
                                    font-size: 11px;
                                }
                            }
                        }
                    }
                }
            }

            // ===== 底部 =====
            Rectangle {
                height: 1px;
                background: #e2e7ef;
            }

            Rectangle {
                background: #ffffff;
                HorizontalBox {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 8px;
                    Text {
                        text: root.status-text;
                        color: #7c8591;
                        font-size: 11px;
                        horizontal-stretch: 1.0;
                        overflow: elide;
                    }

                    Button {
                        text: "添加配置";
                        icon: @image-url("../assets/icons/plus.svg");
                        primary: true;
                        clicked => { root.add-config(); }
                    }
                }
            }
        }

        // --- 确认覆盖层（真模态） ---
        if root.dlg-visible: Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: #66000000;
            TouchArea {
                clicked => {}
            }

            HorizontalBox {
                alignment: center;
                VerticalBox {
                    alignment: center;
                    Rectangle {
                        min-width: 260px;
                        max-width: 296px;
                        background: #ffffff;
                        border-radius: 10px;
                        HorizontalBox {
                            padding: 20px;
                            spacing: 16px;
                            VerticalBox {
                                spacing: 18px;
                                Text {
                                    text: root.dlg-message;
                                    wrap: word-wrap;
                                    font-size: 14px;
                                    color: #15181c;
                                }

                                HorizontalBox {
                                    alignment: end;
                                    spacing: 10px;
                                    Button {
                                        text: "取消";
                                        clicked => { root.cancel-dialog(); }
                                    }

                                    Button {
                                        text: "确定";
                                        primary: true;
                                        clicked => { root.confirm-dialog(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component EditDialog inherits Window {
    title: "编辑配置";
    icon: @image-url("../assets/brewfs.png");
    // Fill the window immediately so it never shows as a transparent hole
    // while the first frame is being prepared.
    background: #f4f6f9;
    preferred-width: 620px;
    preferred-height: 560px;
    min-width: 620px;
    max-width: 620px;
    min-height: 560px;
    max-height: 560px;

    in property <string> edit-title;
    // macOS: keep room for the native traffic-light buttons (hidden titlebar).
    in property <bool> traffic-light-padding;
    // 保存失败/校验错误时显示在对话框内，避免"点了没反应"。
    in property <string> form-error;

    // 表单
    in-out property <string> cfg-name;
    in-out property <int> cfg-mode-index;
    in-out property <int> cfg-drive-index;
    in-out property <string> cfg-drive;
    in-out property <bool> show-free-drives;
    in property <[string]> drive-options;
    in-out property <int> cfg-backend-index;
    in-out property <string> cfg-data-dir;
    in-out property <string> cfg-s3-bucket;
    in-out property <string> cfg-s3-endpoint;
    in-out property <string> cfg-s3-region;
    in-out property <string> cfg-s3-access-key;
    in-out property <string> cfg-s3-secret-key;
    in-out property <bool> cfg-s3-force-path-style;
    in-out property <string> cfg-prefix;
    in-out property <int> cfg-meta-index;
    in-out property <string> cfg-meta-url;

    property <string> cfg-mode: cfg-mode-index == 0 ? "oss" : "brewfs";
    property <string> cfg-backend: cfg-backend-index == 1 ? "s3" : "local-fs";
    property <string> cfg-meta-backend: cfg-meta-index == 1 ? "redis" : (cfg-meta-index == 2 ? "etcd" : (cfg-meta-index == 3 ? "tikv" : "sqlx"));

    callback save-form();
    callback cancel-edit();

    Rectangle {
        width: 620px;
        height: 560px;
        background: #f4f6f9;

        VerticalBox {
            padding: 18px;
            spacing: 14px;

            // macOS: blank row so the traffic-light buttons don't overlap content.
            if root.traffic-light-padding: Rectangle {
                height: 28px;
            }

            Text {
                text: root.edit-title;
                font-size: 16px;
                font-weight: 700;
                color: #15181c;
            }

            ScrollView {
                vertical-stretch: 1.0;
                GridBox {
                    width: 100%;
                    spacing: 10px;
                    Row {
                        Text {
                            text: "配置名称";
                            width: 88px;
                            vertical-alignment: center;
                        }

                        LineEdit {
                            text <=> root.cfg-name;
                            placeholder-text: "例如：阿里云 OSS";
                            horizontal-stretch: 1.0;
                        }
                    }

                    Row {
                        Text {
                            text: "挂载点";
                            width: 88px;
                            vertical-alignment: center;
                        }

                        if root.show-free-drives: ComboBox {
                            model: root.drive-options;
                            current-index: root.cfg-drive-index;
                            horizontal-stretch: 1.0;
                            selected(v) => {
                                root.cfg-drive = v;
                            }
                        }
                        if !root.show-free-drives: LineEdit {
                            text <=> root.cfg-drive;
                            placeholder-text: "macOS/Linux 挂载目录，例如 /Volumes/brewfs";
                            input-type: text;
                            horizontal-stretch: 1.0;
                        }
                    }

                    Row {
                        Text {
                            text: "挂载模式";
                            width: 88px;
                            vertical-alignment: center;
                        }

                        ComboBox {
                            model: ["OSS 直挂（多机，推荐）", "BrewFS（元数据）"];
                            current-index: root.cfg-mode-index;
                            horizontal-stretch: 1.0;
                            selected(v) => {
                                root.cfg-mode-index = v == "BrewFS（元数据）" ? 1 : 0;
                            }
                        }
                    }

                    if root.cfg-mode == "brewfs": Rectangle {
                        background: #fff4e0;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #e0a030;
                        HorizontalBox {
                            padding: 8px;
                            Text {
                                text: "⚠️ 元数据模式需要自建/共享元数据库（Redis/TiKV/etcd）；多机必须连同一个元数据库否则数据不一致；数据库故障则盘不可用。普通网盘推荐 OSS 直挂。";
                                color: #7a4d00;
                                wrap: word-wrap;
                                font-size: 12px;
                            }
                        }
                    }
                    if root.cfg-mode == "brewfs": Row {
                        Text {
                            text: "数据后端";
                            width: 88px;
                            vertical-alignment: center;
                        }

                        ComboBox {
                            model: ["local-fs", "s3"];
                            current-index: root.cfg-backend-index;
                            horizontal-stretch: 1.0;
                            selected(v) => {
                                root.cfg-backend-index = v == "s3" ? 1 : 0;
                            }
                        }
                    }
                    if root.cfg-mode == "brewfs": Row {
                        Text {
                            text: "元数据后端";
                            width: 88px;
                            vertical-alignment: center;
                        }

                        ComboBox {
                            model: ["sqlx", "redis", "etcd", "tikv"];
                            current-index: root.cfg-meta-index;
                            horizontal-stretch: 1.0;
                            selected(v) => {
                                root.cfg-meta-index = v == "redis" ? 1 : (v == "etcd" ? 2 : (v == "tikv" ? 3 : 0));
                            }
                        }
                    }
                    if root.cfg-mode == "brewfs" && root.cfg-backend == "local-fs": Row {
                        Text {
                            text: "数据目录";
                            width: 88px;
                            vertical-alignment: center;
                        }

                        LineEdit {
                            text <=> root.cfg-data-dir;
                            placeholder-text: "本地对象存储目录，例如 E:\\brewfs-data";
                            horizontal-stretch: 1.0;
                        }
                    }
                    if root.cfg-mode == "oss" || (root.cfg-mode == "brewfs" && root.cfg-backend == "s3"): Row {
                        Text {
                            text: "Bucket";
                            width: 88px;
                            vertical-alignment: center;
                        }

                        LineEdit {
                            text <=> root.cfg-s3-bucket;
                            placeholder-text: "OSS bucket 名称";
                            horizontal-stretch: 1.0;
                        }
                    }
                    if root.cfg-mode == "oss" || (root.cfg-mode == "brewfs" && root.cfg-backend == "s3"): Row {
                        Text {
                            text: "Region";
                            width: 88px;
                            vertical-alignment: center;
                        }

                        LineEdit {
                            text <=> root.cfg-s3-region;
                            placeholder-text: "例如 cn-shanghai";
                            horizontal-stretch: 1.0;
                        }
                    }
                    if root.cfg-mode == "oss" || (root.cfg-mode == "brewfs" && root.cfg-backend == "s3"): Row {
                        Text {
                            text: "Endpoint";
                            width: 88px;
                            vertical-alignment: center;
                        }

                        LineEdit {
                            text <=> root.cfg-s3-endpoint;
                            placeholder-text: "S3 兼容接入点，例如 https://s3.oss-cn-shanghai.aliyuncs.com";
                            horizontal-stretch: 1.0;
                        }
                    }
                    if root.cfg-mode == "oss" || (root.cfg-mode == "brewfs" && root.cfg-backend == "s3"): Row {
                        Text {
                            text: "AccessKey";
                            width: 88px;
                            vertical-alignment: center;
                        }

                        LineEdit {
                            text <=> root.cfg-s3-access-key;
                            placeholder-text: "AK";
                            horizontal-stretch: 1.0;
                        }
                    }
                    if root.cfg-mode == "oss" || (root.cfg-mode == "brewfs" && root.cfg-backend == "s3"): Row {
                        Text {
                            text: "SecretKey";
                            width: 88px;
                            vertical-alignment: center;
                        }

                        LineEdit {
                            text <=> root.cfg-s3-secret-key;
                            placeholder-text: "SK（本地保存，不写入提交）";
                            input-type: password;
                            horizontal-stretch: 1.0;
                        }
                    }
                    if root.cfg-mode == "oss" || (root.cfg-mode == "brewfs" && root.cfg-backend == "s3"): Row {
                        Rectangle {
                            width: 88px;
                        }

                        CheckBox {
                            text: "force_path_style（MinIO/自建 S3 需要）";
                            checked <=> root.cfg-s3-force-path-style;
                        }
                    }
                    if root.cfg-mode == "oss": Row {
                        Text {
                            text: "Prefix";
                            width: 88px;
                            vertical-alignment: center;
                        }

                        LineEdit {
                            text <=> root.cfg-prefix;
                            placeholder-text: "对象 key 命名空间（可选），例如 myns/；多机共享时保持一致";
                            horizontal-stretch: 1.0;
                        }
                    }
                    if root.cfg-mode == "brewfs": Row {
                        Text {
                            text: "元数据 URL";
                            width: 88px;
                            vertical-alignment: center;
                        }

                        LineEdit {
                            text <=> root.cfg-meta-url;
                            placeholder-text: "sqlite://./data/brewfs-meta.db?mode=rwc 或 redis://... 或 etcd/tikv 地址（逗号分隔）";
                            horizontal-stretch: 1.0;
                        }
                    }
                }
            }

            if root.form-error != "": Text {
                text: root.form-error;
                color: #c0392b;
                font-size: 12px;
                wrap: word-wrap;
            }

            HorizontalBox {
                alignment: end;
                spacing: 10px;
                Button {
                    text: "取消";
                    clicked => { root.cancel-edit(); }
                }

                Button {
                    text: "保存";
                    primary: true;
                    clicked => { root.save-form(); }
                }
            }
        }
    }
}

export component Tray inherits SystemTrayIcon {
    icon: @image-url("../assets/brewfs.png");
    tooltip: root.tray-tooltip;
    in property <string> tray-tooltip;
    in property <[MountInfo]> mounts;
    in-out property <bool> autostart;

    callback show-window();
    callback open-mount(int);
    callback autostart-changed(bool);
    callback quit-app();

    clicked => {
        root.show-window();
    }

    Menu {
        MenuItem {
            title: "显示窗口";
            activated => { root.show-window(); }
        }

        Menu {
            title: "已挂载盘符";
            for m[i] in root.mounts: MenuItem {
                title: m.drive + "  " + m.backend;
                activated => { root.open-mount(i); }
            }
            if root.mounts.length == 0: MenuItem {
                title: "（无挂载）";
                enabled: false;
            }
        }

        MenuItem {
            // Windows 原生菜单对 checkable 的勾渲染不可靠，直接在标题前加 ✓ 标记状态。
            title: (root.autostart ? "✓ " : "　") + "开机自启";
            activated => {
                root.autostart = !root.autostart;
                root.autostart-changed(root.autostart);
            }
        }

        MenuSeparator { }

        MenuItem {
            title: "退出 BrewFS";
            activated => { root.quit-app(); }
        }
    }
}
